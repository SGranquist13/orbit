{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.1.0",
  "identifier": "dev.steven.orbit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0e0e10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SGranquist13",
    "copyright": "Copyright (c) 2026 SGranquist13",
    "category": "DeveloperTool",
    "shortDescription": "Run a fleet of coding agents in parallel git worktrees and ship.",
    "longDescription": "Orbit is a desktop IDE for running Claude Code and Codex agents side by side in isolated git worktrees, then shipping their work: attention inbox, pull requests, CI, issues, skill packs, AI teammates and routines.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
